# syntax=docker/dockerfile:1
FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

WORKDIR /repo


FROM base AS builder

# Copy the complete workspace metadata/source so PNPM can resolve the worker app
# and all transitive workspace dependencies during install, build, and deploy.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json .npmrc ./
COPY apps/worker ./apps/worker
COPY packages ./packages

# Pin the PNPM store to /pnpm/store so it can be cached with a BuildKit
# cache mount.  In PNPM v11 workspaces the lockfile is a single shared file
# that covers every workspace package.  `pnpm install --filter <pkg>` only
# limits which workspace packages get a node_modules directory — it does NOT
# limit which packages are fetched from the registry.  All packages listed in
# the lockfile (React, Next.js, Playwright, Tailwind, Metro, …) are downloaded
# into the store regardless of the filter.  Caching the store with a BuildKit
# cache mount avoids re-downloading those packages on every build.
#
# We append to the repo's .npmrc (which carries onlyBuiltDependencies) rather
# than overwriting it, so build-script allowlisting is preserved alongside the
# store-dir pin.
RUN echo "store-dir=/pnpm/store" >> .npmrc

# Install dependencies.
# --filter            limits node_modules creation to the worker and its
#                     transitive workspace deps (not registry downloads).
# --frozen-lockfile   fail if the lockfile is out of sync — never mutate it.
# --mount=type=cache  keep the PNPM store warm across builds.
#
# Network resilience:
#   --network-timeout 300000   (5 min per request, up from 30 s default)
#   fetch-retries=5            (up from 2 default)
#   fetch-retry-mintimeout=10000  (10 s minimum between retries)
# These are critical because the shared lockfile forces PNPM to download
# every package in the monorepo (including frontend frameworks, Playwright,
# etc.) even though the worker only needs a small subset.  On a cold cache
# this means hundreds of packages must be fetched, and the default timeouts
# are too aggressive for that volume.
RUN --mount=type=cache,target=/pnpm/store \
    pnpm --filter @tutor-marketplace/worker... install \
      --config.frozen-lockfile=true \
      --config.network-timeout=300000 \
      --config.fetch-retries=5 \
      --config.fetch-retry-mintimeout=10000

# Build the worker.  --frozen-lockfile ensures the lockfile is never mutated
# during the build step either.  The worker's package.json defines a
# "prebuild" script that builds all required workspace packages
# (config, domain, application, database, infrastructure) before the
# "build" script runs `nest build`.
RUN --mount=type=cache,target=/pnpm/store \
    pnpm --filter @tutor-marketplace/worker build

# Deploy creates a self-contained production bundle at /prod/worker with only the
# worker's production dependencies. --legacy is used because this workspace uses
# linked (not injected) internal packages; the default deploy implementation
# requires injected workspace packages.
RUN --mount=type=cache,target=/pnpm/store \
    pnpm --filter @tutor-marketplace/worker deploy --legacy --prod /prod/worker

# pnpm deploy --prod creates a fresh node_modules containing only declared
# production dependencies. The Prisma client generated by `prisma generate`
# is a build artifact, not a declared package, so it is absent from /prod/worker.
#
# @prisma/client resolves the generated client via a RELATIVE require
# (require('.prisma/client/default')) from its own package directory. Under
# pnpm's isolated store layout that directory is
#   node_modules/.pnpm/@prisma+client@<ver>/node_modules/@prisma/client
# so the generated client MUST be placed at the sibling path
#   node_modules/.pnpm/@prisma+client@<ver>/node_modules/.prisma/client
# (NOT at the top-level node_modules/.prisma, which @prisma/client never
# checks). pnpm deploy --prod recreates the store but only with the stub
# throw-files from @prisma/client's postinstall, so the real generated
# client must be copied back into the deploy bundle's store.
#
# The source is the builder's store (same glob pattern). We do NOT hardcode
# the version-specific directory name — the shell glob resolves it at build
# time. We also verify the copy succeeded and that default.js is the real
# generated entry point (not the postinstall stub) before proceeding.
RUN set -e \
    && SRC=$(find /repo/node_modules/.pnpm -maxdepth 1 -type d -name '@prisma+client@*' | head -1) \
    && test -n "$SRC" \
    && test -f "$SRC/node_modules/.prisma/client/default.js" \
    && DST=$(find /prod/worker/node_modules/.pnpm -maxdepth 1 -type d -name '@prisma+client@*' | head -1) \
    && test -n "$DST" \
    && rm -rf "$DST/node_modules/.prisma" \
    && cp -R "$SRC/node_modules/.prisma" "$DST/node_modules/.prisma" \
    && test -f "$DST/node_modules/.prisma/client/default.js" \
    && grep -q "require('.')" "$DST/node_modules/.prisma/client/default.js" \
    && echo "Prisma client verified at $DST/node_modules/.prisma/client"


FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /prod/worker ./

USER nestjs

# The worker is a background process (NestJS application context) with no HTTP
# server.  The healthcheck verifies the process is alive by reading /proc/1/comm
# — the kernel-maintained command name of PID 1.  If the node process has
# crashed the container stops and Docker restarts it (restart: unless-stopped).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "process.exit(require('fs').readFileSync('/proc/1/comm','utf8').trim()==='node'?0:1)" || exit 1

CMD ["node", "dist/main.js"]
