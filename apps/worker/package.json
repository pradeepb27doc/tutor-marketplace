{
  "name": "@tutor-marketplace/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @tutor-marketplace/config build && pnpm --filter @tutor-marketplace/domain build && pnpm --filter @tutor-marketplace/application build && pnpm --filter @tutor-marketplace/database build && pnpm --filter @tutor-marketplace/infrastructure build",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.0.16",
    "@nestjs/core": "11.0.16",
    "@tutor-marketplace/application": "workspace:*",
    "@tutor-marketplace/config": "workspace:*",
    "@tutor-marketplace/database": "workspace:*",
    "@tutor-marketplace/domain": "workspace:*",
    "@tutor-marketplace/infrastructure": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.6",
    "@types/node": "22.14.1",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}