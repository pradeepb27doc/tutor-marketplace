{
  "name": "@tutor-marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @tutor-marketplace/config build && pnpm --filter @tutor-marketplace/domain build && pnpm --filter @tutor-marketplace/application build && pnpm --filter @tutor-marketplace/database build && pnpm --filter @tutor-marketplace/infrastructure build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.0.16",
    "@nestjs/core": "11.0.16",
    "@nestjs/platform-express": "11.0.16",
    "@nestjs/swagger": "^11.4.5",
    "@tutor-marketplace/application": "workspace:*",
    "@tutor-marketplace/config": "workspace:*",
    "@tutor-marketplace/database": "workspace:*",
    "@tutor-marketplace/domain": "workspace:*",
    "@tutor-marketplace/infrastructure": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.6",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "5.0.1",
    "@types/node": "22.14.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}