# =============================================================================
# Tutor Marketplace - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running the application.
#   cp .env.example .env
#
# Required variables must be set. Optional variables have defaults.
# In production, ALL secrets MUST be replaced with strong random values.
# =============================================================================

# --- Database ---
# Required: PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutor_marketplace?schema=public"

# --- Redis ---
# Required: Redis connection string
REDIS_URL="redis://localhost:6379"

# --- JWT Authentication ---
# Required: Secret key for signing JWT tokens (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-production-please-use-a-long-random-secret"
# Optional: Access token expiry in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=900
# Optional: Refresh token expiry in days (default: 30)
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Razorpay (Payment Gateway) ---
# Required for payment features: Razorpay key ID
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# Required for payment features: Razorpay key secret
RAZORPAY_KEY_SECRET="rzp_test_secret_xxxxxxxxxxxx"
# Required for payment webhooks: Razorpay webhook secret
RAZORPAY_WEBHOOK_SECRET="webhook_secret_xxxxxxxxxxxx"

# --- API ---
# Optional: Port for the API server (default: 4000)
API_PORT=4000
# Optional: Comma-separated list of allowed CORS origins in production
# Example: CORS_ORIGINS="https://mentora.app,https://admin.mentora.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Sentry (Error Tracking) ---
# Optional: Sentry DSN for error reporting (leave empty to disable)
SENTRY_DSN=""

# --- Logging ---
# Optional: Log level (debug | info | warn | error) (default: debug)
LOG_LEVEL="debug"
# Optional: Node environment (development | staging | production) (default: development)
NODE_ENV="development"

# --- Frontend (Web & Admin) ---
# Required for web/admin builds: Public API URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional for admin: Public admin URL
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"