    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "prisma": "6.6.0",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}